# Copy this file to `.env.local` (or `.env`) and fill in your project values.

# --- Supabase ---------------------------------------------------------------
# When BOTH are set, Supabase backs real auth (login, forgot/reset password,
# email verification, session persistence) AND the shared data layer.
# When either is missing, the app falls back to the local mock/localStorage layer.
# No surrounding spaces — `KEY= value` keeps the leading space in some parsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Data backend override --------------------------------------------------
# Unset (default): data comes from Supabase whenever the two vars above are set.
# Set to "mock" to force the local localStorage layer (offline / local dev).
# VITE_DATA_BACKEND=mock

# --- Local-dev sign-in ------------------------------------------------------
# Password for the seeded owner account in MOCK AUTH MODE ONLY (i.e. when the
# Supabase vars above are absent). No password ships in the repo, so mock
# sign-in is disabled until this is set. Ignored while Supabase auth is
# configured — real passwords live in Supabase.
# VITE_DEV_LOGIN_PASSWORD=
